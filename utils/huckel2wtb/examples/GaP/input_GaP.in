 # Variaveis Globais 

 &globalvars
  cltit = 'Galium Phosphide'
   nauc = 2 
  numtp = 2 
  nsybz = 4 
   ndiv = 10
 eshift = 12.9710
 /

 # Parametros relativos a celula unitaria:

 &unitcell
 ncell = 2, 2, 2
  lpar = 5.45, 5.45, 5.45
   pv1 = 0.5, 0.5, 0.0        
   pv2 = 0.5, 0.0, 0.5         
   pv3 = 0.0, 0.5, 0.5         
  itype = 1, 2 
    rx = 0.00000, 1.3625 
    ry = 0.00000, 1.3625
    rz = 0.00000, 1.3625
 /

 # Identificação dos orbitais e parâmetros de Huckel:

 &orbitals
    zat = 31, 15
  zsimb = 'Ga', 'P'
  norbv = 3, 3
  nval = 4, 3, 4, 3, 3, 3
  lval = 0, 0, 1, 1, 2, 2
  neao = 2, 2, 1, 3, 0, 0
  rcut = 7.5
  keht = 2.3, 2.3, 2.3, 2.3
  zeta(1,:,:) = 2.0822, 1.6871, 2.0963, 22.0000, 5.6025, 22.0000
  zeta(2,:,:) = 2.0851, 1.6471, 0.8121, 22.0000, 5.6058, 22.0000
    cf(1,:,:) = 0.7602, 0.6245, 0.3080, 0.3493, 0.4915, 0.9334
    cf(2,:,:) = 0.7067, 0.8220, 0.4320, 0.4092, 0.2635, 0.8991
  esit(1,:) = -18.6321, -8.4499, -2.7035
  esit(2,:) = -19.4050,-14.6917, -7.7738 
  /

 # K-Path Para o calculo de Bandas:

  &kpath
        hspbz = 'L', 'Gamma', 'X', 'L'
  kcoord(1,:) = 0.5, 0.5, 0.5
  kcoord(2,:) = 0.0, 0.0, 0.0
  kcoord(3,:) = 0.0, 0.5, 0.5
  kcoord(4,:) = 0.5, 0.5, 0.5
  /
